---
const introBeats = [
  {
    id: 'init',
    start: 0,
    end: 2,
    init: true,
    lines: [[{ text: 'initializing itsjath' }]],
  },
  {
    id: 'use',
    start: 2,
    end: 5.5,
    lines: [
      [{ text: 'SYSTEMS' }],
      [{ text: 'PEOPLE ACTUALLY ' }, { text: 'USE.', accent: true }],
    ],
    caption: 'software · products · operations',
  },
  {
    id: 'stack',
    start: 5.5,
    end: 9.5,
    lines: [
      [{ text: 'BACKEND.' }],
      [{ text: 'PRODUCT.' }],
      [{ text: 'OPERATIONS.', accent: true }],
    ],
    caption: 'java · spring boot · postgresql · docker · git · python · javascript · typescript · c# · sql · lua · html/css',
  },
  {
    id: 'reach',
    start: 9.5,
    end: 14,
    lines: [
      [{ text: 'SHIPPED PRODUCTS' }],
      [{ text: 'THAT ' }, { text: 'REACHED', accent: true }],
    ],
    countTo: 78000000,
    caption: 'plays & views across the portfolio',
  },
  {
    id: 'studio',
    start: 14,
    end: 18,
    lines: [
      [{ text: 'SHIPPED CODE.' }],
      [{ text: 'RAN THE ' }, { text: 'STUDIO.', accent: true }],
    ],
    caption: '15+ projects shipped · 100+ collaborators · live operations',
  },
  {
    id: 'final',
    start: 18,
    end: 22,
    lines: [
      [{ text: 'BUILDING SYSTEMS' }],
      [{ text: 'THAT ' }, { text: 'MOVE', accent: true }, { text: '.', purple: true }],
    ],
    caption: 'JATH · software engineer · product · operator',
  },
] as const;

const introMedia = [
  {
    type: 'video',
    src: '/images/work/forestlygames/studio/fg-showcase-260129-v003.mp4',
    poster: '/images/work/forestlygames/studio/fg-showcase-poster.jpg',
    className: 'intro-media--primary',
    startAt: 12,
  },
  {
    type: 'image',
    src: '/images/work/forestlygames/studio/escape-bruno-mirabel-glow.png',
    className: 'intro-media--bruno',
  },
  {
    type: 'image',
    src: '/images/work/forestlygames/studio/roempires-gameplay-village.jpg',
    className: 'intro-media--roempires',
  },
  {
    type: 'image',
    src: '/images/work/forestlygames/studio/encaved-cave-entrance.png',
    className: 'intro-media--encaved',
  },
  {
    type: 'image',
    src: '/images/work/forestlygames/studio/boss-battles-thumbnail.png',
    className: 'intro-media--boss',
  },
] as const;

type IntroBeat = (typeof introBeats)[number];
type IntroLinePart = IntroBeat['lines'][number][number];

const isInitBeat = (beat: IntroBeat) => 'init' in beat && beat.init === true;
const isAccentPart = (part: IntroLinePart) => 'accent' in part && part.accent === true;
const isPurplePart = (part: IntroLinePart) => 'purple' in part && part.purple === true;
---

<div class="intro" data-intro data-intro-duration="22" aria-label="Intro sequence">
  <div class="intro__texture" aria-hidden="true"></div>
  <div class="intro__vignette" aria-hidden="true"></div>

  <div class="intro__media" aria-hidden="true">
    {
      introMedia.map((media, index) => (
        <figure class:list={['intro__panel', media.className]} data-intro-media data-media-index={index}>
          {media.type === 'video' ? (
            <video
              data-intro-video
              data-intro-video-start={media.startAt}
              src={media.src}
              poster={media.poster}
              muted
              loop
              playsinline
              preload="metadata"
            />
          ) : (
            <img src={media.src} alt="" loading="eager" decoding="async" />
          )}
        </figure>
      ))
    }
  </div>

  <div class="intro__beats" aria-live="polite">
    {
      introBeats.map((beat, index) => (
        <section
          class:list={['intro__beat', isInitBeat(beat) && 'intro__beat--init']}
          data-intro-beat
          data-intro-beat-id={beat.id}
          data-intro-beat-index={index}
          data-intro-beat-start={beat.start}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <div class="intro__headline">
            {beat.lines.map((line) => (
              <span class="intro__headline-line">
                {line.map((part) =>
                  isAccentPart(part) ? (
                    <em>{part.text}</em>
                  ) : isPurplePart(part) ? (
                    <span class="intro__purple" data-intro-purple-dot>{part.text}</span>
                  ) : (
                    <span>{part.text}</span>
                  ),
                )}
              </span>
            ))}
          </div>
          {'countTo' in beat && (
            <p class="intro__count" data-intro-count data-intro-count-to={beat.countTo}>
              0
            </p>
          )}
          {'caption' in beat && <p class="intro__caption">{beat.caption}</p>}
        </section>
      ))
    }
  </div>

  <button type="button" class="intro__skip" data-intro-skip>Skip intro</button>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 9000;
    overflow: hidden;
    color: var(--white-000);
    background:
      radial-gradient(circle at 82% 20%, color-mix(in srgb, var(--purple-500) 44%, transparent), transparent 46%),
      radial-gradient(circle at 60% 72%, color-mix(in srgb, var(--purple-700) 42%, transparent), transparent 52%),
      radial-gradient(circle at 12% 86%, color-mix(in srgb, var(--gold-700) 15%, transparent), transparent 42%),
      var(--black-000);
    font-family: var(--font-display);
    isolation: isolate;
  }

  .intro__texture,
  .intro__vignette,
  .intro__media {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .intro__texture {
    z-index: 0;
    opacity: 0.64;
    background-image:
      linear-gradient(color-mix(in srgb, var(--white-500) 8%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--purple-300) 14%, transparent) 1px, transparent 1px);
    background-size: 4rem 4rem;
    mask-image: radial-gradient(circle at 54% 48%, black 0%, transparent 72%);
  }

  .intro__vignette {
    z-index: 3;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--black-000) 90%, transparent) 0%, transparent 50%, color-mix(in srgb, var(--purple-700) 22%, transparent) 100%),
      radial-gradient(circle at 52% 48%, transparent 0%, color-mix(in srgb, var(--black-000) 60%, transparent) 78%),
      linear-gradient(180deg, color-mix(in srgb, var(--black-000) 70%, transparent), transparent 36%, color-mix(in srgb, var(--black-000) 70%, transparent));
  }

  .intro__media {
    z-index: 1;
  }

  .intro__panel {
    position: absolute;
    margin: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--purple-300) 32%, transparent);
    border-radius: 8px;
    background: var(--black-100);
    box-shadow: 0 1.5rem 5rem color-mix(in srgb, var(--black-000) 70%, transparent);
    opacity: 0;
    transform: translate3d(0, 1rem, 0) scale(1.02);
  }

  .intro__panel::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--black-000) 4%, transparent), color-mix(in srgb, var(--black-000) 32%, transparent)),
      radial-gradient(circle at 22% 18%, color-mix(in srgb, var(--purple-300) 26%, transparent), transparent 38%);
  }

  .intro__panel video,
  .intro__panel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.22) saturate(0.9) brightness(0.74) contrast(1.08);
    transform: scale(1.04);
  }

  .intro-media--primary {
    right: min(4vw, 4rem);
    top: 10vh;
    width: min(70rem, 66vw);
    height: min(39rem, 58vh);
  }

  .intro-media--bruno {
    right: 7vw;
    bottom: 9vh;
    width: min(25rem, 32vw);
    height: min(18rem, 26vh);
  }

  .intro-media--roempires {
    left: 47vw;
    bottom: 12vh;
    width: min(20rem, 27vw);
    height: min(13rem, 19vh);
  }

  .intro-media--encaved {
    right: 20vw;
    top: 6vh;
    width: min(21rem, 25vw);
    height: min(13rem, 18vh);
  }

  .intro-media--boss {
    left: 56vw;
    top: 38vh;
    width: min(16rem, 21vw);
    height: min(11rem, 16vh);
  }

  .intro__beats {
    position: relative;
    z-index: 5;
    display: grid;
    min-height: 100%;
    padding: calc(var(--nav-height) + var(--content-pad)) var(--content-pad) calc(var(--content-pad) * 3);
    place-items: center start;
  }

  .intro__beat {
    grid-area: 1 / 1;
    width: min(64rem, 100%);
    opacity: 0;
    transform: translateY(1.5rem);
  }

  .intro__beat--init {
    width: auto;
  }

  .intro__headline {
    display: grid;
    gap: 0.08em;
    font-size: 6.8rem;
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: 0;
    text-wrap: balance;
    text-transform: uppercase;
  }

  .intro__beat--init .intro__headline {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    font-weight: 500;
    line-height: 1.4;
    color: var(--gold-300);
  }

  .intro__headline-line {
    display: block;
  }

  .intro__headline em {
    color: var(--gold-300);
    font-style: normal;
    text-shadow: 0 0 2.5rem color-mix(in srgb, var(--gold-500) 32%, transparent);
  }

  .intro__purple {
    color: var(--purple-300);
    display: inline-block;
    text-shadow: 0 0 2.2rem color-mix(in srgb, var(--purple-500) 64%, transparent);
  }

  .intro__caption {
    max-width: 48rem;
    margin: 1.3rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--white-300);
    text-transform: lowercase;
  }

  .intro__count {
    margin: 1.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 5.2rem;
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: 0;
    color: var(--gold-300);
    text-shadow: 0 0 4rem color-mix(in srgb, var(--gold-500) 40%, transparent);
  }

  .intro__skip {
    position: absolute;
    z-index: 8;
    bottom: var(--content-pad);
    left: var(--content-pad);
    padding: 0.72rem 1rem;
    border: 1px solid color-mix(in srgb, var(--gold-500) 38%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--black-200) 68%, transparent);
    color: var(--white-100);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0.76;
    backdrop-filter: blur(14px);
  }

  .intro__skip:focus-visible {
    outline: 2px solid var(--gold-300);
    outline-offset: 4px;
  }

  @media (max-width: 840px) {
    .intro__beats {
      padding-top: calc(var(--nav-height) + (var(--content-pad) * 1.6));
      padding-bottom: 9rem;
      align-items: center;
    }

    .intro__headline {
      font-size: 3.4rem;
      line-height: 0.95;
    }

    .intro__count {
      font-size: 3.1rem;
    }

    .intro__caption {
      font-size: var(--text-xs);
    }

    .intro-media--primary {
      right: -18vw;
      top: 16vh;
      width: 96vw;
      height: 44vh;
    }

    .intro-media--bruno {
      right: 4vw;
      bottom: 16vh;
      width: 52vw;
      height: 23vh;
    }

    .intro-media--roempires,
    .intro-media--encaved,
    .intro-media--boss {
      display: none;
    }
  }
</style>
