---
import BaseLayout from './BaseLayout.astro';
import ForestlyGamesCaseStudy from '../components/work/ForestlyGamesCaseStudy.astro';
import { caseStudyIntro } from '../utils/page-intros';
import { categoryLabels, type PortfolioExperience, type PortfolioText } from '../data/portfolio';

interface Props {
  project: PortfolioExperience;
}

const { project } = Astro.props;
const {
  title,
  role,
  dates,
  problem,
  outcome,
  technologies,
  takeaway,
  cover,
  gallery,
  metrics,
  demo,
  videos,
  status,
  category,
  shortSummary,
  caseStudy,
} = project;

const textParts = (text: PortfolioText) => (Array.isArray(text) ? text : [text]);
const isForestlyGamesStudio = project.layout?.caseStudyVariant === 'forestlygames-studio';
const summaryRows = [
  { label: 'Role', value: role },
  { label: 'Timeline', value: dates.timeline },
  { label: 'Problem', value: problem },
  { label: 'Outcome', value: outcome },
  { label: 'Skills demonstrated', value: technologies?.join(' - ') },
].filter((row): row is { label: string; value: string } => Boolean(row.value));
---

{
  isForestlyGamesStudio ? (
    <ForestlyGamesCaseStudy project={project} />
  ) : (
<BaseLayout title={title} description={shortSummary} intro={caseStudyIntro(title)}>
  <article class="container section page-enter" data-page-content>
    {cover && (
      <figure class="case-hero">
        <img src={cover} alt="" class="case-hero__img" loading="eager" decoding="async" />
      </figure>
    )}

    <header class="page-header" style="padding-top: 0;">
      <p class="meta page-header__eyebrow">
        {categoryLabels[category] ?? category}{status ? ` - ${status}` : ''} - {dates.display}
      </p>
      <h1>{title}</h1>
      <p class="lead" style="margin-top: 1rem;">{shortSummary}</p>
    </header>

    {
      metrics && metrics.length > 0 && (
        <dl class="case-metrics" aria-label="Project metrics">
          {metrics.map((m) => (
            <div class="case-metrics__item">
              <dt class="case-metrics__value">{m.value}</dt>
              <dd class="case-metrics__label">{m.label}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {takeaway && (
      <blockquote class="case-pull">
        <strong>What this shows</strong>
        {takeaway}
      </blockquote>
    )}

    {
      demo && (
        <section class="case-demo" aria-label="Project demo">
          <p class="case-demo__label">{demo.label ?? 'Gameplay demo'}</p>
          <div class="case-demo__frame">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${demo.youtubeId}`}
              title={demo.label ?? `${title} demo`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        </section>
      )
    }

    {
      summaryRows.length > 0 && (
        <dl class="case-summary">
          {summaryRows.map((row) => (
            <>
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </>
          ))}
        </dl>
      )
    }

    {
      videos && videos.length > 0 && (
        <section class="case-videos" aria-labelledby="creator-videos">
          <h2 id="creator-videos" class="case-videos__title">Creator coverage</h2>
          <div class="case-videos__grid">
            {videos.map((video) => (
              <figure class="case-video">
                <div class="case-video__frame">
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`}
                    title={video.title}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  />
                </div>
                <figcaption class="case-video__cap">
                  <span class="case-video__name">{video.title}</span>
                  {video.note && <span class="case-video__note">{video.note}</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {gallery && gallery.length > 0 && (
      <div class="case-gallery" aria-label="Project gallery">
        {gallery.map((image) => (
          <figure class="case-gallery__item">
            <img src={image.src} alt={image.alt ?? ''} loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>
    )}

    {caseStudy?.sections && caseStudy.sections.length > 0 && (
      <div class="prose">
        {caseStudy.sections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            {section.blocks.map((block) =>
              block.type === 'paragraph' ? (
                <p>
                  {textParts(block.text).map((part) =>
                    typeof part === 'string' ? (
                      part
                    ) : part.href ? (
                      <a href={part.href}>{part.text}</a>
                    ) : part.emphasis ? (
                      <em>{part.text}</em>
                    ) : (
                      part.text
                    ),
                  )}
                </p>
              ) : (
                <ul>
                  {block.items.map((item) => (
                    <li>
                      {textParts(item).map((part) =>
                        typeof part === 'string' ? (
                          part
                        ) : part.href ? (
                          <a href={part.href}>{part.text}</a>
                        ) : part.emphasis ? (
                          <em>{part.text}</em>
                        ) : (
                          part.text
                        ),
                      )}
                    </li>
                  ))}
                </ul>
              ),
            )}
          </section>
        ))}
      </div>
    )}
  </article>
</BaseLayout>
  )
}
